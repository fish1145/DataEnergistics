.trinity-pattern-core-root {
    width: 176px;
    height: 256px;
    background: sprite(ae2:textures/guis/me_digital_pattern_processing_core.png, 0, 0, 176, 256);
}

.trinity-pattern-core-panel {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 176px;
    height: 172px;
}

.trinity-pattern-core-title {
    position: absolute;
    left: 8px;
    top: 5px;
    width: 160px;
    height: 9px;
    adaptive-width: false;
    adaptive-height: false;
    text-shadow: false;
}

.trinity-pattern-core-grid {
    position: absolute;
    left: 16px;
    top: 16px;
    width: 144px;
    height: 144px;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
}

.trinity-pattern-core-slot {
    width: 18px;
    height: 18px;
}

.trinity-pattern-core-previous-page,
.trinity-pattern-core-next-page,
.trinity-pattern-core-refund-all {
    position: absolute;
    top: 160px;
    width: 16px;
    height: 12px;
}

.trinity-pattern-core-previous-page { left: 16px; }
.trinity-pattern-core-next-page { left: 124px; }
.trinity-pattern-core-refund-all { left: 144px; }

.trinity-pattern-core-page-info {
    position: absolute;
    left: 36px;
    top: 161px;
    width: 84px;
    height: 10px;
    adaptive-width: false;
    adaptive-height: false;
    horizontal-align: center;
    vertical-align: center;
    text-shadow: false;
}

.trinity-pattern-player-inventory {
    position: absolute;
    left: 7px;
    top: 171px;
    width: 162px;
    height: 77px;
}

.trinity-pattern-player-inventory-grid,
.trinity-pattern-player-hotbar-grid {
    position: absolute;
    left: 0px;
    width: 162px;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
}

.trinity-pattern-player-inventory-grid {
    top: 0px;
    height: 54px;
}

.trinity-pattern-player-hotbar-grid {
    top: 58px;
    height: 18px;
}

.trinity-pattern-player-inventory-slot {
    width: 18px;
    height: 18px;
}

.trinity-hosted-window {
    position: absolute;
    left: -8px;
    top: 0px;
    width: 292px;
    height: 210px;
}

.trinity-auto-build-drag-handle {
    position: absolute;
    left: 2px;
    top: 2px;
    width: 272px;
    height: 16px;
}

.trinity-auto-build-window-title {
    position: absolute;
    left: 5px;
    top: 0px;
    width: 262px;
    height: 16px;
    adaptive-width: false;
    adaptive-height: false;
    font-size: 8.5;
    text-color: #FFFFFFFF;
    vertical-align: center;
    text-wrap: hover_roll;
    text-shadow: false;
    overflow: hidden;
}

.trinity-auto-build-window-close {
    position: absolute;
    left: 274px;
    top: 2px;
    width: 16px;
    height: 16px;
}

.trinity-hosted-preview {
    position: absolute;
    left: 4px;
    top: 22px;
    width: 196px;
    height: 184px;
}

.trinity-hosted-side-panel {
    position: absolute;
    left: 204px;
    top: 22px;
    width: 84px;
    height: 184px;
}

.trinity-auto-build-panel {
    width: 65px;
    height: 22px;
    background: sprite(data_energistics:textures/guis/autobuild/structure_switch.png);
}

.trinity-auto-build-structure-selector {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 84px;
    height: 38px;
    background: rect(#FF303040);
}

.trinity-auto-build-structure-previous,
.trinity-auto-build-structure-next {
    position: absolute;
    top: 10px;
    width: 18px;
    height: 18px;
}

.trinity-auto-build-structure-previous { left: 0px; }
.trinity-auto-build-structure-next { left: 66px; }

.trinity-auto-build-structure-title {
    position: absolute;
    left: 20px;
    top: 0px;
    width: 44px;
    height: 38px;
    adaptive-width: false;
    adaptive-height: false;
    font-size: 7.5;
    horizontal-align: center;
    vertical-align: center;
    text-wrap: wrap;
    text-shadow: false;
    overflow: hidden;
}

.trinity-auto-build-requested {
    position: absolute;
    left: 0px;
    top: 44px;
    width: 84px;
    height: 20px;
}

.trinity-auto-build-toggle-label {
    flex: 0;
    width: 62px;
    adaptive-width: false;
    adaptive-height: false;
    text-wrap: hover_roll;
    overflow: hidden;
}

.trinity-auto-build-confirm {
    position: absolute;
    left: 0px;
    top: 166px;
    width: 84px;
    height: 18px;
    overflow: hidden;
}

.trinity-auto-build-confirm .__button_text__ {
    flex: 0;
    width: 62px;
    adaptive-width: false;
    adaptive-height: false;
    horizontal-align: left;
    text-wrap: hover_roll;
    overflow: hidden;
}

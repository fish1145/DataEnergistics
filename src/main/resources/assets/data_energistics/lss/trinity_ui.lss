.trinity-auto-build-structure-title {
    adaptive-width: false;
    adaptive-height: false;
    font-size: 5.5;
    horizontal-align: center;
    vertical-align: center;
    text-wrap: hover_roll;
    text-shadow: false;
    overflow: hidden;
}

.trinity-auto-build-adjustment-title,
.trinity-auto-build-adjustment-value {
    adaptive-width: false;
    adaptive-height: false;
    horizontal-align: center;
    vertical-align: center;
    text-wrap: hover_roll;
    text-shadow: false;
    overflow: hidden;
}

.trinity-auto-build-adjustment-title {
    font-size: 5;
    text-color: #FF555568;
}

.trinity-auto-build-adjustment-value {
    font-size: 5.5;
    text-color: #FF404052;
}

.trinity-auto-build-material-amount {
    adaptive-width: false;
    adaptive-height: false;
    font-size: 5;
    text-color: #FFFFFFFF;
    horizontal-align: right;
    vertical-align: bottom;
    text-shadow: true;
    overflow: hidden;
}

.trinity-auto-build-confirm-title {
    adaptive-width: false;
    adaptive-height: false;
    font-size: 5;
    horizontal-align: center;
    vertical-align: center;
    text-wrap: hover_roll;
    text-shadow: false;
    overflow: hidden;
}

#trinity_data_core_root,
#trinity_storage_hosted_window,
#trinity_pattern_hosted_window,
#trinity_information_exchange_depot_root {
    padding-all: 5px;
    gap-all: 4px;
}

.trinity-information-exchange-title,
.trinity-information-exchange-mode-title,
.trinity-information-exchange-section-title,
.trinity-information-exchange-label,
.trinity-information-exchange-value,
.trinity-information-exchange-mode-caption {
    adaptive-width: false;
    adaptive-height: false;
    vertical-align: center;
    text-shadow: false;
    overflow: hidden;
}

.trinity-information-exchange-title {
    font-size: 7.5;
    text-color: #FF343548;
    horizontal-align: left;
    text-wrap: hover_roll;
}

.trinity-information-exchange-mode-title {
    font-size: 7.5;
    text-color: #FF343548;
    horizontal-align: center;
    text-wrap: none;
}

.trinity-information-exchange-section-title {
    font-size: 6.5;
    text-color: #FF343548;
    horizontal-align: left;
    text-wrap: none;
}

.trinity-information-exchange-label {
    font-size: 6;
    text-color: #FF4A4B60;
    horizontal-align: left;
    text-wrap: none;
}

.trinity-information-exchange-value {
    font-size: 6;
    text-color: #FF246082;
    horizontal-align: left;
    text-wrap: hover_roll;
}

.trinity-information-exchange-mode-caption {
    font-size: 6;
    text-color: #FF414255;
    horizontal-align: center;
    text-wrap: hover_roll;
}

button.__disabled__ .__button_text__ {
    text-color: #FF666666;
    text-shadow: false;
}

.trinity-storage-entry-name,
.trinity-storage-entry-amount {
    adaptive-width: false;
    adaptive-height: false;
    font-size: 6;
    vertical-align: center;
    overflow: hidden;
}

.trinity-storage-entry-name {
    text-color: #FF404052;
    horizontal-align: left;
    text-wrap: hover_roll;
    text-shadow: false;
}

.trinity-storage-entry-amount {
    text-color: #FFFFFFFF;
    horizontal-align: left;
    text-shadow: true;
}

.trinity-storage-type-capacity {
    adaptive-width: false;
    adaptive-height: false;
    font-size: 6;
    horizontal-align: center;
    vertical-align: center;
    text-wrap: hover_roll;
    overflow: hidden;
    text-shadow: false;
}

.priority-control-title {
    adaptive-width: false;
    adaptive-height: false;
    font-size: 7;
    vertical-align: center;
    text-shadow: false;
    overflow: hidden;
}

.priority-control-step-text {
    adaptive-width: false;
    adaptive-height: false;
    font-size: 6;
    horizontal-align: center;
    vertical-align: center;
    text-shadow: false;
    overflow: hidden;
}

.priority-control-value {
    font-size: 7;
    text-shadow: false;
}

.priority-control-hint {
    adaptive-width: false;
    adaptive-height: false;
    font-size: 6;
    horizontal-align: center;
    vertical-align: center;
    text-wrap: hover_roll;
    text-shadow: false;
    overflow: hidden;
}

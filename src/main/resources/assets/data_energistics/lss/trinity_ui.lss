.trinity-pattern-core-root {
    width: 176px;
    height: 256px;
    background: sprite(ae2:textures/guis/me_digital_pattern_processing_core.png, 0, 0, 176, 256);
}

.trinity-pattern-core-panel {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 176px;
    height: 172px;
}

.trinity-pattern-core-title {
    position: absolute;
    left: 8px;
    top: 5px;
    width: 160px;
    height: 9px;
    adaptive-width: false;
    adaptive-height: false;
    text-shadow: false;
}

.trinity-pattern-core-grid {
    position: absolute;
    left: 16px;
    top: 16px;
    width: 144px;
    height: 144px;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
}

.trinity-pattern-core-slot {
    width: 18px;
    height: 18px;
}

.trinity-pattern-core-previous-page,
.trinity-pattern-core-next-page,
.trinity-pattern-core-refund-all {
    position: absolute;
    top: 160px;
    width: 16px;
    height: 12px;
}

.trinity-pattern-core-previous-page { left: 16px; }
.trinity-pattern-core-next-page { left: 124px; }
.trinity-pattern-core-refund-all { left: 144px; }

.trinity-pattern-core-page-info {
    position: absolute;
    left: 36px;
    top: 161px;
    width: 84px;
    height: 10px;
    adaptive-width: false;
    adaptive-height: false;
    horizontal-align: center;
    vertical-align: center;
    text-shadow: false;
}

.trinity-pattern-player-inventory {
    position: absolute;
    left: 7px;
    top: 171px;
    width: 162px;
    height: 77px;
}

.trinity-pattern-player-inventory-grid,
.trinity-pattern-player-hotbar-grid {
    position: absolute;
    left: 0px;
    width: 162px;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
}

.trinity-pattern-player-inventory-grid {
    top: 0px;
    height: 54px;
}

.trinity-pattern-player-hotbar-grid {
    top: 58px;
    height: 18px;
}

.trinity-pattern-player-inventory-slot {
    width: 18px;
    height: 18px;
}

.trinity-auto-build-structure-title {
    adaptive-width: false;
    adaptive-height: false;
    font-size: 5.5;
    horizontal-align: center;
    vertical-align: center;
    text-wrap: hover_roll;
    text-shadow: false;
    overflow: hidden;
}

.trinity-auto-build-adjustment-title,
.trinity-auto-build-adjustment-value {
    adaptive-width: false;
    adaptive-height: false;
    horizontal-align: center;
    vertical-align: center;
    text-wrap: hover_roll;
    text-shadow: false;
    overflow: hidden;
}

.trinity-auto-build-adjustment-title {
    font-size: 5;
    text-color: #FF555568;
}

.trinity-auto-build-adjustment-value {
    font-size: 5.5;
    text-color: #FF404052;
}

.trinity-auto-build-material-amount {
    adaptive-width: false;
    adaptive-height: false;
    font-size: 5;
    text-color: #FFFFFFFF;
    horizontal-align: right;
    vertical-align: bottom;
    text-shadow: true;
    overflow: hidden;
}
#trinity_data_core_root {
    padding-all: 5px;
    gap-all: 4px;
}

#trinity_storage_hosted_window {
    padding-all: 5px;
    gap-all: 4px;
}

.trinity-storage-entry-name,
.trinity-storage-entry-amount {
    adaptive-width: false;
    adaptive-height: false;
    font-size: 6;
    vertical-align: center;
    overflow: hidden;
}

.trinity-storage-entry-name {
    text-color: #FF404052;
    horizontal-align: left;
    text-wrap: hover_roll;
    text-shadow: false;
}

.trinity-storage-entry-amount {
    text-color: #FFFFFFFF;
    horizontal-align: left;
    text-shadow: true;
}

.trinity-storage-type-capacity {
    adaptive-width: false;
    adaptive-height: false;
    font-size: 6;
    horizontal-align: center;
    vertical-align: center;
    text-wrap: hover_roll;
    overflow: hidden;
    text-shadow: false;
}
